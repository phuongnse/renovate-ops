{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "configMigration": true,
  "branchPrefix": "automation/renovate/",
  "dependencyDashboard": true,
  "draftPR": true,
  "labels": ["dependencies", "operations"],
  "schedule": ["before 5am on monday"],
  "timezone": "Asia/Ho_Chi_Minh",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "constraints": {
    "python": "==3.14"
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/process\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "prBodyTemplate": "<!-- engineering-process:pr-description:start -->\n## Summary\n\nRenovate proposes one normal locked dependency update for the operations control plane.\n\n{{{table}}}\n\n## Contract and scope\n\nDependency automation follows repository-owned manifests; engineering-process updates include the complete managed adoption transaction.\n\n## Impact and risk\n\nThe dependency proposal requires project verification and review under repository policy.\n\n## Verification\n\nProject checks validate the exact published dependency checkpoint.\n\n## Independent review\n\nA separate reviewer approves the complete verified adoption checkpoint before merge.\n\n## Requirements and rules followed\n\n- [ ] **Scope and contract** — accepted scope is implemented without unapproved expansion. [status: pending]\n- [ ] **Verification evidence** — required current profiles pass on the published checkpoint. [status: pending]\n- [ ] **Independent review** — a separate reviewer approved the published checkpoint with no open required finding. [status: pending]\n<!-- engineering-process:pr-description:end -->",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": [
        "renovate-version: (?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64}) # renovate: datasource=docker depName=(?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Adopt each published engineering-process release as a complete managed pull request.",
      "matchFileNames": [
        "requirements/process.in",
        "requirements/process.txt"
      ],
      "matchPackageNames": [
        "engineering-process"
      ],
      "enabled": true,
      "draftPR": true,
      "groupName": "engineering-process",
      "groupSlug": "engineering-process",
      "schedule": [
        "at any time"
      ],
      "prPriority": 100,
      "commitMessageTopic": "engineering-process",
      "postUpgradeTasks": {
        "commands": [
          "python .process/adopt-process.py --project-root . --requirements-lock requirements/process.txt"
        ],
        "fileFilters": [
          ".agents/skills/**",
          ".github/PULL_REQUEST_TEMPLATE.md",
          ".process/adopt-process.py",
          ".process/automation.json",
          ".process/adopt-process-windows-job.py",
          ".process/adoption-migrations/**",
          ".process/process.lock",
          ".process/project.json",
          "AGENTS.md"
        ],
        "executionMode": "update",
        "installTools": {
          "python": {}
        }
      }
    },
    {
      "description": "Keep the Renovate runtime and wrapper action together for review",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate",
        "renovatebot/github-action"
      ],
      "groupName": "Renovate runtime",
      "prPriority": 100
    }
  ]
}
