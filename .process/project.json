{
  "lifecycle": {
    "requiredProfiles": [
      "development",
      "review"
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "unit",
        "run": [
          "node",
          "--test"
        ],
        "timeoutSeconds": 900
      }
    ],
    "review": [
      {
        "id": "global-renovate-config",
        "run": [
          "node",
          "node_modules/renovate/dist/config-validator.js",
          "config.cjs",
          "--strict"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "repository-renovate-config",
        "run": [
          "node",
          "node_modules/renovate/dist/config-validator.js",
          ".github/renovate.json5",
          "--strict"
        ],
        "timeoutSeconds": 300
      }
    ]
  },
  "project": "renovate-ops",
  "schemaVersion": 5,
  "setup": [
    {
      "id": "prepare-validation-runtime",
      "run": [
        "npm",
        "rebuild",
        "re2"
      ],
      "timeoutSeconds": 300
    }
  ]
}
