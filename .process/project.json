{
  "schemaVersion": 3,
  "project": "renovate-ops",
  "lifecycle": {
    "requiredProfiles": [
      "development",
      "review"
    ]
  },
  "profiles": {
    "development": [
      {
        "id": "unit",
        "run": [
          "node",
          "--test"
        ],
        "timeoutSeconds": 900
      }
    ],
    "review": [
      {
        "id": "global-renovate-config",
        "run": [
          "node",
          "node_modules/renovate/dist/config-validator.js",
          "config.cjs",
          "--strict"
        ],
        "timeoutSeconds": 300
      },
      {
        "id": "repository-renovate-config",
        "run": [
          "node",
          "node_modules/renovate/dist/config-validator.js",
          ".github/renovate.json5",
          "--strict"
        ],
        "timeoutSeconds": 300
      }
    ]
  },
  "environment": {
    "defaultProfile": "development",
    "foregroundOnly": true,
    "managedTools": [],
    "profiles": {
      "development": [
        "git-runtime",
        "node-runtime",
        "validation-runtime"
      ],
      "review": [
        "git-runtime",
        "node-runtime",
        "validation-runtime"
      ]
    },
    "requirements": [
      {
        "id": "git-runtime",
        "description": "Git command-line client required for lifecycle checkpoints and source provenance",
        "probe": {
          "run": [
            "git",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^git version 2\\.[0-9]+\\.[0-9]+"
        },
        "remediation": "Install a supported Git 2.x command-line client, then rerun doctor."
      },
      {
        "id": "node-runtime",
        "description": "Node.js 24.18.0 required by the Renovate operations control plane",
        "probe": {
          "run": [
            "node",
            "--version"
          ],
          "timeoutSeconds": 15,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^v24\\.18\\.0\\r?$"
        },
        "remediation": "Install Node.js 24.18.0, then rerun doctor."
      },
      {
        "id": "validation-runtime",
        "description": "Exact locked install-script policy and native RE2 runtime required by canonical Renovate validation",
        "probe": {
          "run": [
            "node",
            "scripts/verify-validation-runtime.mjs"
          ],
          "timeoutSeconds": 30,
          "readOnly": true,
          "outputStream": "stdout",
          "outputRegex": "^Renovate validation runtime ready\\r?$"
        },
        "remediation": "Run processctl setup for the selected profile with project-files approval after npm ci --ignore-scripts.",
        "setupAction": "prepare-validation-runtime"
      }
    ],
    "setupActions": [
      {
        "id": "prepare-validation-runtime",
        "kind": "command",
        "run": [
          "npm",
          "rebuild",
          "re2"
        ],
        "timeoutSeconds": 300,
        "mutations": [
          "project-files"
        ],
        "requires": []
      }
    ]
  }
}
