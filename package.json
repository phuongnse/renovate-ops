{
  "name": "renovate-ops",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "test": "node --test",
    "validate": "renovate-config-validator config.cjs --strict && renovate-config-validator .github/renovate.json5 --strict",
    "check": "npm run test && npm run validate",
    "bootstrap:protect": "node scripts/configure-branch-protection.mjs"
  },
  "allowScripts": {
    "core-js-pure": false,
    "dtrace-provider": false,
    "re2@1.26.1": true
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "renovate": "44.37.1"
  }
}
